{
  "name": "ExpenseSplitter",
  "version": "0.1.0",
  "description": "A tool for splitting shared expenses",
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "babel-cli": "^6.16.0",
    "babel-core": "^6.2.4",
    "babel-eslint": "^7.0.0",
    "babel-loader": "^6.2.5",
    "babel-plugin-ramda": "^1.1.6",
    "babel-plugin-transform-object-rest-spread": "^6.16.0",
    "babel-preset-es2015": "^6.16.0",
    "babel-preset-react": "^6.16.0",
    "babel-register": "^6.16.3",
    "babel-watch": "^2.0.3",
    "chai": "^3.5.0",
    "chai-enzyme": "^0.6.1",
    "chai-http": "^3.0.0",
    "css-loader": "^0.25.0",
    "enzyme": "^2.6.0",
    "eslint": "^1.7.3",
    "eslint-config-airbnb": "^0.1.0",
    "eslint-loader": "^1.5.0",
    "eslint-plugin-react": "^3.6.3",
    "extract-text-webpack-plugin": "^1.0.1",
    "file-loader": "^0.9.0",
    "font-awesome-sass-loader": "^1.0.2",
    "html-webpack-plugin": "^2.22.0",
    "image-webpack-loader": "^2.0.0",
    "jsdom": "^9.8.3",
    "json-loader": "^0.5.4",
    "mocha": "^3.1.2",
    "nock": "^9.0.2",
    "node-sass": "^3.11.2",
    "proxyquire": "^1.7.3",
    "react-addons-test-utils": "^15.3.2",
    "react-css-modules": "^3.7.10",
    "react-tools": "^0.13.3",
    "redux-mock-store": "^1.2.1",
    "resolve-url-loader": "^1.6.0",
    "sass-loader": "^4.0.2",
    "sinon": "^1.17.2",
    "sinon-as-promised": "^4.0.2",
    "sinon-chai": "^2.8.0",
    "skeleton-scss": "^2.0.4",
    "style-loader": "^0.13.1",
    "url-loader": "^0.5.7",
    "webpack": "^1.13.2",
    "webpack-dev-server": "^1.16.1",
    "webpack-hot-middleware": "^2.12.2"
  },
  "scripts": {
    "clean": "rm -rf ./build",
    "start": "npm run start-server | npm run start-client",
    "start-client": "env NODE_ENV=development webpack-dev-server --config webpack.client.config.js",
    "start-server": "env NODE_ENV=development NODE_PATH=./src/ babel-watch ./src/server/index.js -w",
    "build-dev": "env NODE_ENV=development npm run build-server && env NODE_ENV=development npm run build-client",
    "build-prod": "env NODE_ENV=production npm run build-server && env NODE_ENV=production npm run build-client",
    "build-server": "rm -rf ./build/server && webpack --config webpack.server.config.js --progress --colors",
    "build-client": "rm -rf ./build/client && webpack --config webpack.client.config.js --progress --colors",
    "test": "npm run test-common && npm run test-server && npm run test-client",
    "test-server": "env NODE_PATH=./src:./src/client NODE_ENV=test ./node_modules/.bin/mocha 'test/server/**/*.spec.js' --require ./test/server/support/testsetup.js --compilers js:babel-register || exit 0",
    "test-client": "env NODE_PATH=./src/client/:./src/ NODE_ENV=test ./node_modules/.bin/mocha 'test/client/**/*.spec.{js,jsx}' --require ./test/client/support/testsetup.js --recursive --compilers 'jsx:test/client/support/jsxcompiler, .:babel-register' || exit 0",
    "test-common": "env NODE_PATH=./src NODE_ENV=test ./node_modules/.bin/mocha 'test/common/**/*.spec.js' --recursive --compilers .:babel-register || exit 0",
    "test-debug": "node debug --harmony ./node_modules/.bin/mocha --runInBand",
    "stats": "rm -rf ./build/client && env NODE_ENV=production webpack --config webpack.client.config.js --json | webpack-bundle-size-analyzer"
  },
  "dependencies": {
    "axios": "^0.15.1",
    "body-parser": "^1.15.2",
    "bootstrap-sass": "^3.3.7",
    "bunyan": "^1.8.4",
    "classnames": "^2.2.0",
    "clipboard": "^1.5.12",
    "compression": "^1.6.2",
    "express": "^4.14.0",
    "font-awesome": "^4.6.3",
    "helmet": "^3.1.0",
    "morgan": "^1.7.0",
    "nano": "^6.2.0",
    "object-path-immutable": "^0.5.0",
    "ramda": "^0.23.0",
    "react": "^15.3.2",
    "react-bootstrap": "^0.30.3",
    "react-dom": "^15.3.2",
    "react-notification-system": "^0.2.10",
    "react-redux": "^4.4.5",
    "react-router": "^2.8.1",
    "react-swipeable": "^3.6.0",
    "redux": "^3.6.0",
    "redux-axios-middleware": "^3.0.0",
    "redux-logger": "^2.7.0",
    "redux-thunk": "^2.1.0",
    "shortid": "^2.2.4"
  }
}
