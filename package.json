  "scripts": {
    "prod": "gulp --type prod",
    "start": "gulp --type dev",
    "build": "gulp build",
    "test": "jest",
    "test-debug": "node debug --harmony ./node_modules/.bin/jest --runInBand"
  },
  "jest": {
    "scriptPreprocessor": "<rootDir>/node_modules/babel-jest",
    "testPathDirs": [
      "<rootDir>/src/js/__tests__/"
    ],
    "testPathIgnorePatterns": [
      "__tests__/support"
    ],
    "testFileExtensions": [
      "es6",
      "js",
      "jsx"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "es6"
    ],
    "unmockedModulePathPatterns": [
      "react",
      "react-dom",
      "react-addons-test-utils",
      "classnames",
      "sinon",
      "lodash"
    ]
  },
  "dependencies": {
    "axios": "^0.7.0",
    "classnames": "^2.2.0",
