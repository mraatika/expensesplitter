    "gulp-imagemin": "^2.4.0",
    "gulp-sass": "^2.0.4",
    "gulp-sourcemaps": "^1.6.0",
    "gulp-uglify": "^1.4.2",
    "gulp-util": "^3.0.7",
    "jest-cli": "^0.8.0",
    "react-addons-test-utils": "^0.14.2",
